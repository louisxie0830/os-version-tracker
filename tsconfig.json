{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    // Only import/export makes a file a module: src/browser/*.ts have neither and compile to classic
    // scripts (<script defer>) instead of ending in "export {}"; every other file under src/ imports
    "moduleDetection": "legacy",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
