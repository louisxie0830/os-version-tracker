       ],
       "type": "unorderedList"
      },
      {
       "inlineContent": [
        {
         "text": "In your ",
         "type": "text"
        },
        {
         "identifier": "doc://com.apple.bundleresources/documentation/BundleResources/App-Privacy-Configuration/NSPrivacyAccessedAPITypes/NSPrivacyAccessedAPITypeReasons",
         "isActive": true,
         "type": "reference"
        },
        {
         "text": " array, supply the relevant values from this list.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "items": [
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to display file timestamps to the person using the device.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may not be sent off-device.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "DDA9.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to access the timestamps, size, or other metadata of files inside the app container, app group container, or the app\u2019s CloudKit container.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "C617.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to access the timestamps, size, or other metadata of files or directories that the user specifically granted access to, such as using a document picker view controller.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "3B52.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason if your third-party SDK is providing a wrapper function around file timestamp API(s) for the app to use, and you only access the file timestamp APIs when the app calls your wrapper function. This reason may only be declared by third-party SDKs. This reason may not be declared if your third-party SDK was created primarily to wrap required reason API(s).",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may not be used for your third-party SDK\u2019s own purposes or sent off-device by your third-party SDK.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "0A2A.1",
            "type": "codeVoice"
           }
          ]
         }
        }
       ],
       "type": "termList"
      }
     ],
     "name": "NSPrivacyAccessedAPICategoryFileTimestamp"
    },
    {
     "content": [
      {
       "inlineContent": [
        {
         "text": "The following APIs for accessing the system boot time require reasons for use.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "items": [
        {
         "content": [
          {
           "inlineContent": [
            {
             "identifier": "doc://com.apple.documentation/documentation/Foundation/ProcessInfo/systemUptime",
             "isActive": true,
             "type": "reference"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "code": "mach_absolute_time()",
             "type": "codeVoice"
            }
           ],
           "type": "paragraph"
          }
         ]
        }
       ],
       "type": "unorderedList"
      },
      {
       "inlineContent": [
        {
         "text": "In your ",
         "type": "text"
        },
        {
         "identifier": "doc://com.apple.bundleresources/documentation/BundleResources/App-Privacy-Configuration/NSPrivacyAccessedAPITypes/NSPrivacyAccessedAPITypeReasons",
         "isActive": true,
         "type": "reference"
        },
        {
         "text": " array, supply the relevant values from the list below.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "items": [
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to access the system boot time in order to measure the amount of time that has elapsed between events that occurred within the app or to perform calculations to enable timers.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may not be sent off-device. There is an exception for information about the amount of time that has elapsed between events that occurred within the app, which may be sent off-device.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "35F9.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to access the system boot time to calculate absolute timestamps for events that occurred within your app, such as events related to the ",
              "type": "text"
             },
             {
              "identifier": "doc://com.apple.documentation/documentation/UIKit",
              "isActive": true,
              "type": "reference"
             },
             {
              "text": " or ",
              "type": "text"
             },
             {
              "identifier": "doc://com.apple.documentation/documentation/AVFAudio",
              "isActive": true,
              "type": "reference"
             },
             {
              "text": " frameworks. Absolute timestamps for events that occurred within your app may be sent off-device. System boot time accessed for this reason, or any other information derived from system boot time, may not be sent off-device.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "8FFB.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to include system boot time information in an optional bug report that the person using the device chooses to submit. The system boot time information must be prominently displayed to the person as part of the report.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may be sent off-device only after the user affirmatively chooses to submit the specific bug report including system boot time information, and only for the purpose of investigating or responding to the bug report.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "3D61.1",
            "type": "codeVoice"
           }
          ]
         }
        }
       ],
       "type": "termList"
      }
     ],
     "name": "NSPrivacyAccessedAPICategorySystemBootTime"
    },
    {
     "content": [
      {
       "inlineContent": [
        {
         "text": "The following APIs for accessing the available disk space require reasons for use.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "items": [
        {
         "content": [
          {
           "inlineContent": [
            {
             "identifier": "doc://com.apple.documentation/documentation/Foundation/URLResourceKey/volumeAvailableCapacityKey",
             "isActive": true,
             "type": "reference"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "identifier": "doc://com.apple.documentation/documentation/Foundation/URLResourceKey/volumeAvailableCapacityForImportantUsageKey",
             "isActive": true,
             "type": "reference"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
