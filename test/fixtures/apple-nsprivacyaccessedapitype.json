           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "identifier": "doc://com.apple.documentation/documentation/Foundation/FileAttributeKey/systemFreeSize",
             "isActive": true,
