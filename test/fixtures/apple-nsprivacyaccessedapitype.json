           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "identifier": "doc://com.apple.documentation/documentation/Foundation/URLResourceKey/volumeTotalCapacityKey",
             "isActive": true,
