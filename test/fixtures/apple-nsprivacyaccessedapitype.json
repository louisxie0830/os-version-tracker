            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "identifier": "doc://com.apple.documentation/documentation/Foundation/FileAttributeKey/systemSize",
             "isActive": true,
             "type": "reference"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "code": "statfs(_:_:)",
             "type": "codeVoice"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "code": "statvfs(_:_:)",
             "type": "codeVoice"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "code": "fstatfs(_:_:)",
             "type": "codeVoice"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "code": "fstatvfs(_:_:)",
             "type": "codeVoice"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "code": "getattrlist(_:_:_:_:_:)",
             "type": "codeVoice"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "code": "fgetattrlist(_:_:_:_:_:)",
             "type": "codeVoice"
            }
           ],
           "type": "paragraph"
          }
         ]
        },
        {
         "content": [
          {
           "inlineContent": [
            {
             "code": "getattrlistat(_:_:_:_:_:_:)",
             "type": "codeVoice"
            }
           ],
           "type": "paragraph"
          }
         ]
        }
       ],
       "type": "unorderedList"
      },
      {
       "inlineContent": [
        {
         "text": "In your ",
         "type": "text"
        },
        {
         "identifier": "doc://com.apple.bundleresources/documentation/BundleResources/App-Privacy-Configuration/NSPrivacyAccessedAPITypes/NSPrivacyAccessedAPITypeReasons",
         "isActive": true,
         "type": "reference"
        },
        {
         "text": " array, supply the relevant values from the list below.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "items": [
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to display disk space information to the person using the device. Disk space may be displayed in units of information (such as bytes) or units of time combined with a media type (such as minutes of HD video).",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may not be sent off-device. There is an exception that allows the app to send disk space information over the local network to another device operated by the same person only for the purpose of displaying disk space information on that device; this exception only applies if the user has provided explicit permission to send disk space information, and the information may not be sent over the Internet.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "85F4.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to check whether there is sufficient disk space to write files, or to check whether the disk space is low so that the app can delete files when the disk space is low. The app must behave differently based on disk space in a way that is observable to users.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may not be sent off-device. There is an exception that allows the app to avoid downloading files from a server when disk space is insufficient.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "E174.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to include disk space information in an optional bug report that the person using the device chooses to submit. The disk space information must be prominently displayed to the person as part of the report.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may be sent off-device only after the user affirmatively chooses to submit the specific bug report including disk space information, and only for the purpose of investigating or responding to the bug report.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "7D9E.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason if your app is a health research app, and you access this API category to detect and inform research participants about low disk space impacting the research data collection.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Your app must comply with ",
              "type": "text"
             },
             {
              "identifier": "https://developer.apple.com/app-store/review/guidelines/#health-and-health-research",
              "isActive": true,
              "type": "reference"
             },
             {
              "text": ". Your app must not offer any functionality other than providing information about and allowing people to participate in health research.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "B728.1",
            "type": "codeVoice"
           }
          ]
         }
        }
       ],
       "type": "termList"
      }
     ],
     "name": "NSPrivacyAccessedAPICategoryDiskSpace"
    },
    {
     "content": [
      {
       "inlineContent": [
        {
         "text": "The following API for accessing the list of active keyboards requires reasons for use.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "items": [
        {
         "content": [
          {
           "inlineContent": [
            {
             "identifier": "doc://com.apple.documentation/documentation/UIKit/UITextInputMode/activeInputModes",
             "isActive": true,
             "type": "reference"
            }
           ],
           "type": "paragraph"
          }
         ]
        }
       ],
       "type": "unorderedList"
      },
      {
       "inlineContent": [
        {
         "text": "In your ",
         "type": "text"
        },
        {
         "identifier": "doc://com.apple.bundleresources/documentation/BundleResources/App-Privacy-Configuration/NSPrivacyAccessedAPITypes/NSPrivacyAccessedAPITypeReasons",
         "isActive": true,
         "type": "reference"
        },
        {
         "text": " array, supply the relevant values from the list below.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "items": [
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason if your app is a custom keyboard app, and you access this API category to determine the keyboards that are active on the device. Providing a systemwide custom keyboard to the user must be the primary functionality of the app.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may not be sent off-device.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "3EC4.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to access active keyboard information to present the correct customized user interface to the person using the device. The app must have text fields for entering or editing text and must behave differently based on active keyboards in a way that is observable to users.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may not be sent off-device.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "54BD.1",
            "type": "codeVoice"
           }
          ]
         }
        }
       ],
       "type": "termList"
      }
     ],
     "name": "NSPrivacyAccessedAPICategoryActiveKeyboards"
    },
    {
     "content": [
      {
       "inlineContent": [
        {
         "text": "The following API for accessing user defaults requires reasons for use.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "items": [
        {
         "content": [
          {
           "inlineContent": [
            {
             "identifier": "doc://com.apple.documentation/documentation/Foundation/UserDefaults",
             "isActive": true,
             "type": "reference"
            }
           ],
           "type": "paragraph"
          }
         ]
        }
       ],
       "type": "unorderedList"
      },
      {
       "inlineContent": [
        {
         "text": "In your ",
         "type": "text"
        },
        {
         "code": "NSPrivacyAccessedAPITypeReasons",
         "type": "codeVoice"
        },
        {
         "text": " array, supply the relevant values from the list below.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "items": [
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to access user defaults to read and write information that is only accessible to the app itself.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "This reason does not permit reading information that was written by other apps or the system, or writing information that can be accessed by other apps.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "CA92.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to access user defaults to read and write information that is only accessible to the apps, app extensions, and App Clips that are members of the same App Group as the app itself.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "This reason does not permit reading information that was written by apps, app extensions, or App Clips outside the same App Group or by the system. Your app is not responsible if the system provides information from the global domain because a key is not present in your requested domain while your app is attempting to read information that apps, app extensions, or App Clips in your app\u2019s App Group write.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "This reason also does not permit writing information that can be accessed by apps, app extensions, or App Clips outside the same App Group.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "1C8F.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason if your third-party SDK is providing a wrapper function around user defaults API(s) for the app to use, and you only access the user defaults APIs when the app calls your wrapper function. This reason may only be declared by third-party SDKs. This reason may not be declared if your third-party SDK was created primarily to wrap required reason API(s).",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "inlineContent": [
             {
              "text": "Information accessed for this reason, or any derived information, may not be used for your third-party SDK\u2019s own purposes or sent off-device by your third-party SDK.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "C56D.1",
            "type": "codeVoice"
           }
          ]
         }
        },
        {
         "definition": {
          "content": [
           {
            "inlineContent": [
             {
              "text": "Declare this reason to access user defaults to read the ",
              "type": "text"
             },
             {
              "code": "com.apple.configuration.managed",
              "type": "codeVoice"
             },
             {
              "text": " key to retrieve the managed app configuration set by MDM, or to set the ",
              "type": "text"
             },
             {
              "code": "com.apple.feedback.managed",
              "type": "codeVoice"
             },
             {
              "text": " key to store feedback information to be queried over MDM, as described in the Apple Mobile Device Management Protocol Reference documentation.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ]
         },
         "term": {
          "inlineContent": [
           {
            "code": "AC6B.1",
            "type": "codeVoice"
           }
          ]
         }
        }
       ],
       "type": "termList"
      }
     ],
     "name": "NSPrivacyAccessedAPICategoryUserDefaults"
    }
   ]
  }
